rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountAccessPath(userUid) {
      return /databases/$(database)/documents/accountAccess/$(userUid);
    }

    function isAccountEnabled(userUid) {
      return !exists(accountAccessPath(userUid))
        || get(accountAccessPath(userUid)).data.get('disabled', false) != true;
    }

    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid)/profile/company;
      return signedIn()
        && isAccountEnabled(request.auth.uid)
        && exists(profilePath)
        && get(profilePath).data.get('role', '').lower()
          .replace('_', '').replace('-', '').replace(' ', '') == 'superadmin';
    }

    // Allow a user to read their own company profile doc so the app can
    // determine their role. Also allow superadmins. This prevents a
    // circular permission-check situation where isSuperAdmin() needs to read
    // the profile but the profile read itself was only allowed for superadmins.
    function canReadOwnCompanyProfile(userUid) {
      return signedIn() && (request.auth.uid == userUid || isSuperAdmin());
    }

    function validSubscriptionPlan(data) {
      return data.keys().hasOnly([
          'amount',
          'durationDays',
          'version',
          'updatedAt',
          'updatedBy',
          'mobileLogos',
          'cardLogos'
        ])
        && data.keys().hasAll([
          'amount',
          'durationDays',
          'version',
          'updatedAt',
          'updatedBy'
        ])
        && data.amount is int
        && data.amount > 0
        && data.durationDays is int
        && data.durationDays > 0
        && data.durationDays <= 3650
        && data.version is int
        && data.version > 0
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validPlatformVersionPolicy(data) {
      return data is map
        && data.keys().hasOnly([
          'enabled',
          'minimumVersion',
          'minimumBuild',
          'updateUrl'
        ])
        && data.keys().hasAll([
          'enabled',
          'minimumVersion',
          'minimumBuild',
          'updateUrl'
        ])
        && data.enabled is bool
        && data.minimumVersion is string
        && data.minimumVersion.size() > 0
        && data.minimumVersion.size() <= 20
        && data.minimumVersion.matches('^[0-9]+(\\.[0-9]+){1,3}$')
        && data.minimumBuild is int
        && data.minimumBuild >= 0
        && data.updateUrl is string
        && data.updateUrl.size() <= 2048
        && (!data.enabled || data.updateUrl.matches('https://[^ ]+'));
    }

    function validAppVersionPolicy(data) {
      return data.keys().hasOnly([
          'message',
          'platforms',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasAll([
          'message',
          'platforms',
          'updatedAt',
          'updatedBy'
        ])
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 500
        && data.platforms is map
        && data.platforms.keys().hasOnly(['android', 'windows', 'web'])
        && data.platforms.keys().hasAll(['android', 'windows', 'web'])
        && validPlatformVersionPolicy(data.platforms.android)
        && validPlatformVersionPolicy(data.platforms.windows)
        && validPlatformVersionPolicy(data.platforms.web)
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validDownloadItem(item) {
      return item is map
        && item.keys().hasOnly(['enabled', 'url', 'version'])
        && item.keys().hasAll(['enabled', 'url', 'version'])
        && item.enabled is bool
        && item.url is string
        && item.url.size() <= 2048
        && (!item.enabled || item.url.matches('https://[^ ]+'))
        && item.version is string
        && item.version.size() <= 30;
    }

    function validDownloadCenter(data) {
      return data.keys().hasOnly(['title', 'subtitle', 'items', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['title', 'subtitle', 'items', 'updatedAt', 'updatedBy'])
        && data.title is string
        && data.title.size() <= 80
        && data.subtitle is string
        && data.subtitle.size() <= 300
        && data.items is map
        && data.items.keys().hasOnly(['playstore', 'appstore', 'apk', 'windows', 'web'])
        && data.items.keys().hasAll(['playstore', 'appstore', 'apk', 'windows', 'web'])
        && validDownloadItem(data.items.playstore)
        && validDownloadItem(data.items.appstore)
        && validDownloadItem(data.items.apk)
        && validDownloadItem(data.items.windows)
        && validDownloadItem(data.items.web)
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validSupportCenter(data) {
      return data.keys().hasOnly([
          'whatsappNumber', 'faqs', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'whatsappNumber', 'faqs', 'updatedAt', 'updatedBy'
        ])
        && data.whatsappNumber is string
        && (
          data.whatsappNumber == ''
          || data.whatsappNumber.matches('^[0-9]{8,15}$')
        )
        && data.faqs is list
        && data.faqs.size() <= 50
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function hasPrivilegedRole(role) {
      return role in [
        'admin',
        'Admin',
        'ADMIN',
        'superadmin',
        'super_admin',
        'super-admin',
        'Super Admin'
      ];
    }

    function membershipPath(employeeUid) {
      return /databases/$(database)/documents/employeeMemberships/$(employeeUid);
    }

    function businessMembershipPath(businessUid, employeeUid) {
      return /databases/$(database)/documents/businessMemberships/$(businessUid)/members/$(employeeUid);
    }

    function hasMembershipFor(businessUid, employeeUid) {
      return (
          exists(membershipPath(employeeUid))
          && get(membershipPath(employeeUid)).data.businessUid == businessUid
        )
        || (
          exists(businessMembershipPath(businessUid, employeeUid))
          && get(businessMembershipPath(businessUid, employeeUid)).data.businessUid == businessUid
        );
    }

    function membershipData(businessUid, employeeUid) {
      return exists(businessMembershipPath(businessUid, employeeUid))
        ? get(businessMembershipPath(businessUid, employeeUid)).data
        : get(membershipPath(employeeUid)).data;
    }

    function companyProfilePath(businessUid) {
      return /databases/$(database)/documents/users/$(businessUid)/profile/company;
    }

    function isBusinessOwner(businessUid) {
      return signedIn()
        && isAccountEnabled(request.auth.uid)
        && isAccountEnabled(businessUid)
        && (
          (
            request.auth.uid == businessUid
            && !hasMembershipFor(businessUid, request.auth.uid)
            && exists(companyProfilePath(businessUid))
          )
          || (
            exists(businessMembershipPath(businessUid, request.auth.uid))
            && membershipData(businessUid, request.auth.uid).get('role', '') == 'owner'
            && membershipData(businessUid, request.auth.uid).get('active', false) == true
          )
        );
    }

    function hasActiveMembership(businessUid) {
      return signedIn()
        && isAccountEnabled(request.auth.uid)
        && isAccountEnabled(businessUid)
        && hasMembershipFor(businessUid, request.auth.uid)
        && membershipData(businessUid, request.auth.uid).get('active', false) == true;
    }

    function hasPermission(businessUid, module, action) {
      return isBusinessOwner(businessUid)
        || (
          hasActiveMembership(businessUid)
          && membershipData(businessUid, request.auth.uid)
            .get('permissions', {})
            .get(module, {})
            .get(action, false) == true
        );
    }

    function canAccessTransactionShop(businessUid, data) {
      return isBusinessOwner(businessUid)
        || (
          hasActiveMembership(businessUid)
          && membershipData(businessUid, request.auth.uid)
            .get('shopNickname', '') is string
          && membershipData(businessUid, request.auth.uid)
            .get('shopNickname', '').size() > 0
          && data.get('shopNickname', '')
            == membershipData(businessUid, request.auth.uid)
              .get('shopNickname', '')
        );
    }

    function canAccessDebtShop(businessUid, data) {
      return isBusinessOwner(businessUid)
        || (
          hasActiveMembership(businessUid)
          && membershipData(businessUid, request.auth.uid)
            .get('shopNickname', '') is string
          && membershipData(businessUid, request.auth.uid)
            .get('shopNickname', '').size() > 0
          && data.get('shopNickname', '')
            == membershipData(businessUid, request.auth.uid)
              .get('shopNickname', '')
        );
    }

    function canViewCategories(businessUid) {
      return hasPermission(businessUid, 'categories', 'view')
        || hasPermission(businessUid, 'transactions', 'view')
        || hasPermission(businessUid, 'transactions', 'create')
        || hasPermission(businessUid, 'analytics', 'view')
        || hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'quotations', 'create');
    }

    function canViewProfile(businessUid) {
      return hasPermission(businessUid, 'profile', 'view')
        || hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'quotations', 'create')
        || hasPermission(businessUid, 'receipts', 'create')
        || hasPermission(businessUid, 'jobs', 'create');
    }

    function hasBusinessVerificationDocument(businessUid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(businessUid)/businessDocuments/tin)
        || exists(/databases/$(database)/documents/publicProfiles/$(businessUid)/businessDocuments/tra)
        || exists(/databases/$(database)/documents/publicProfiles/$(businessUid)/businessDocuments/brela)
        || exists(/databases/$(database)/documents/publicProfiles/$(businessUid)/businessDocuments/other);
    }

    function invoiceModule(data) {
      return data.get('kind', 'invoice') == 'quotation'
        ? 'quotations'
        : 'invoices';
    }

    function canAccessDocument(businessUid, data, action) {
      return hasPermission(businessUid, invoiceModule(data), action);
    }

    match /accountAccess/{userUid} {
      allow get: if signedIn()
        && (request.auth.uid == userUid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && userUid != request.auth.uid
        && request.resource.data.get('disabled', false) == true
        && request.resource.data.get('disabledBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'disabled',
          'disabledAt',
          'disabledBy'
        ]);
      allow update: if isSuperAdmin()
        && userUid != request.auth.uid
        && request.resource.data.get('disabled', false) is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'disabled',
          'disabledAt',
          'disabledBy',
          'enabledAt',
          'enabledBy'
        ]);
      allow delete: if false;
    }

    function isPersonalAccount(userUid) {
      return signedIn()
        && request.auth.uid == userUid
        && isAccountEnabled(userUid);
    }

    function personalSessionPath(userUid) {
      return /databases/$(database)/documents/personalUsers/$(userUid)/device/session;
    }

    // Personal data is only available to the sign-in session that last claimed
    // the account, which limits a Personal account to one device at a time.
    function isPersonalDevice(userUid) {
      return isPersonalAccount(userUid)
        && (
          !exists(personalSessionPath(userUid))
          || get(personalSessionPath(userUid)).data.get('authTime', -1)
            == request.auth.token.auth_time
        );
    }

    function validPersonalProfile(data) {
      return data.keys().hasOnly([
          'displayName',
          'photoUrl',
          'currency',
          'dateFormat',
          'notificationsEnabled',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.photoUrl is string
        && data.photoUrl.size() <= 2048
        && (
          data.photoUrl == ''
          || data.photoUrl.matches('https://[^ ]+')
        )
        && data.currency in ['TZS', 'KES', 'USD']
        && data.dateFormat in ['dd/MM/yyyy', 'MM/dd/yyyy', 'yyyy-MM-dd']
        && data.notificationsEnabled is bool
        && data.updatedAt == request.time;
    }

    function validPersonalTransaction(data) {
      return data.keys().hasOnly([
          'type',
          'description',
          'category',
          'amount',
          'date',
          'createdAt'
        ])
        && data.type in ['income', 'expense']
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 160
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.amount is number
        && data.amount > 0
        && data.date is timestamp
        && data.createdAt == request.time;
    }

    function validPersonalBudget(data) {
      return data.keys().hasOnly(['name', 'amount', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.amount is number
        && data.amount > 0
        && data.updatedAt == request.time;
    }

    function validPersonalGoal(data) {
      return data.keys().hasOnly([
          'name',
          'targetAmount',
          'savedAmount',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.targetAmount is number
        && data.targetAmount > 0
        && data.savedAmount is number
        && data.savedAmount >= 0
        && data.savedAmount <= data.targetAmount
        && data.updatedAt == request.time;
    }

    match /personalUsers/{userUid} {
      allow get: if isPersonalDevice(userUid);
      allow list, delete: if false;
      allow create, update: if isPersonalDevice(userUid)
        && validPersonalProfile(request.resource.data);

      match /device/{deviceDoc} {
        allow read: if isPersonalAccount(userUid);
        allow create, update: if isPersonalAccount(userUid)
          && deviceDoc == 'session'
          && request.resource.data.keys().hasOnly([
            'deviceId',
            'platform',
            'authTime',
            'updatedAt'
          ])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() > 0
          && request.resource.data.deviceId.size() <= 64
          && request.resource.data.platform is string
          && request.resource.data.authTime == request.auth.token.auth_time
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isPersonalDevice(userUid);
        allow create: if isPersonalDevice(userUid)
          && validPersonalTransaction(request.resource.data);
        allow update: if false;
      }

      match /budgets/{budgetId} {
        allow read, delete: if isPersonalDevice(userUid);
        allow create, update: if isPersonalDevice(userUid)
          && validPersonalBudget(request.resource.data);
      }

      match /savingsGoals/{goalId} {
        allow read, delete: if isPersonalDevice(userUid);
        allow create, update: if isPersonalDevice(userUid)
          && validPersonalGoal(request.resource.data);
      }
    }

    match /employeeMemberships/{employeeUid} {
      allow get: if signedIn()
        && (
          request.auth.uid == employeeUid
          || (
            resource.data.businessUid == request.auth.uid
            && isBusinessOwner(request.auth.uid)
          )
        );
      allow list: if signedIn()
        && isBusinessOwner(request.auth.uid)
        && resource.data.businessUid == request.auth.uid;
      allow create: if signedIn()
        && employeeUid != request.auth.uid
        && isBusinessOwner(request.auth.uid)
        && request.resource.data.employeeUid == employeeUid
        && request.resource.data.businessUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.businessEmail is string
        && request.resource.data.businessName is string
        && request.resource.data.shopNickname is string
        && request.resource.data.shopNickname.size() > 0
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.keys().hasOnly([
          'employeeUid',
          'businessUid',
          'businessEmail',
          'businessName',
          'shopNickname',
          'name',
          'email',
          'phone',
          'active',
          'permissions',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]);
      allow update: if signedIn()
        && employeeUid != request.auth.uid
        && isBusinessOwner(request.auth.uid)
        && resource.data.businessUid == request.auth.uid
        && request.resource.data.businessUid == resource.data.businessUid
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'email',
            'phone',
            'permissions',
            'active',
            'removed',
            'shopNickname',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.shopNickname is string
        && request.resource.data.shopNickname.size() > 0
        && request.resource.data.get('active', false) is bool
        && request.resource.data.get('removed', false) is bool
        && (
          request.resource.data.get('removed', false) != true
          || request.resource.data.active == false
        );
      allow delete: if signedIn()
        && employeeUid != request.auth.uid
        && isBusinessOwner(request.auth.uid)
        && resource.data.businessUid == request.auth.uid;
    }

    match /businessMemberships/{businessUid}/members/{employeeUid} {
      allow get: if signedIn()
        && (
          request.auth.uid == employeeUid
          || isBusinessOwner(businessUid)
        );
      allow list: if signedIn()
        && (
          isBusinessOwner(businessUid)
          || resource.data.employeeUid == request.auth.uid
        );
      allow create, delete: if false;
      allow update: if signedIn()
        && employeeUid != request.auth.uid
        && isBusinessOwner(businessUid)
        && resource.data.businessUid == businessUid
        && resource.data.employeeUid == employeeUid
        && resource.data.get('role', '') == 'staff'
        && request.resource.data.businessUid == resource.data.businessUid
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.get('role', '') == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'email',
            'phone',
            'permissions',
            'active',
            'removed',
            'shopNickname',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.shopNickname is string
        && request.resource.data.shopNickname.size() > 0
        && request.resource.data.get('active', false) is bool
        && request.resource.data.get('removed', false) is bool
        && (
          request.resource.data.get('removed', false) != true
          || request.resource.data.active == false
        );
    }

    // Lets a signed-in user list only their own memberships across businesses.
    match /{path=**}/members/{employeeUid} {
      allow list: if signedIn()
        && resource.data.employeeUid == request.auth.uid;
    }

    match /businessInvitations/{invitationCode} {
      allow read, write: if false;
    }

    match /users/{businessUid}/{document=**} {
      allow read: if isBusinessOwner(businessUid);
      allow create: if isBusinessOwner(businessUid)
        && !hasPrivilegedRole(request.resource.data.get('role', ''));
      allow update: if isBusinessOwner(businessUid)
        && request.resource.data.get('role', '')
          == resource.data.get('role', '');
      allow delete: if isBusinessOwner(businessUid);
    }

    match /users/{businessUid}/transactions/{transactionId} {
      allow read: if (
          hasPermission(businessUid, 'transactions', 'view')
          || hasPermission(businessUid, 'analytics', 'view')
        )
        && canAccessTransactionShop(businessUid, resource.data);
      allow create: if hasPermission(businessUid, 'transactions', 'create')
        && canAccessTransactionShop(businessUid, request.resource.data);
      allow update: if hasPermission(businessUid, 'transactions', 'edit')
        && canAccessTransactionShop(businessUid, resource.data)
        && canAccessTransactionShop(businessUid, request.resource.data);
      allow delete: if hasPermission(businessUid, 'transactions', 'delete')
        && canAccessTransactionShop(businessUid, resource.data);
    }

    match /users/{businessUid}/categories/{categoryId} {
      allow read: if canViewCategories(businessUid);
      allow create: if hasPermission(businessUid, 'categories', 'create');
      allow update: if hasPermission(businessUid, 'categories', 'edit');
      allow delete: if hasPermission(businessUid, 'categories', 'delete');
    }

    match /users/{businessUid}/profile/{profileId} {
      allow read: if (
          request.auth != null
          && request.auth.uid == businessUid
          && profileId == 'company'
        )
        || canViewProfile(businessUid);
      allow create: if (
          profileId == 'company'
          && signedIn()
          && request.auth.uid == businessUid
          && isAccountEnabled(businessUid)
          && !exists(membershipPath(request.auth.uid))
          && request.resource.data.get('name', '') is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.get('ownerName', '') is string
          && request.resource.data.ownerName.size() <= 100
          && !hasPrivilegedRole(request.resource.data.get('role', ''))
        )
        || (
          hasPermission(businessUid, 'profile', 'edit')
          && (
            profileId != 'company'
            || !hasPrivilegedRole(request.resource.data.get('role', ''))
          )
        );
      allow update: if hasPermission(businessUid, 'profile', 'edit')
        && (
          profileId != 'company'
          || request.resource.data.get('role', '')
            == resource.data.get('role', '')
        );
      allow delete: if hasPermission(businessUid, 'profile', 'delete');
    }

    match /users/{businessUid}/invoices/{documentId} {
      allow read: if canAccessDocument(businessUid, resource.data, 'view');
      allow create: if canAccessDocument(
        businessUid,
        request.resource.data,
        'create'
      );
      allow update: if invoiceModule(resource.data)
          == invoiceModule(request.resource.data)
        && canAccessDocument(businessUid, resource.data, 'edit');
      allow delete: if canAccessDocument(businessUid, resource.data, 'delete');
    }

    function canReadProducts(businessUid) {
      return hasPermission(businessUid, 'stock', 'view')
        || hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'invoices', 'edit')
        || hasPermission(businessUid, 'quotations', 'create');
    }

    function canMoveSaleStock(businessUid) {
      return hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'invoices', 'delete');
    }

    // Quantity/cost may only change together with a ledger movement, written
    // by the app in the same transaction. Staff without stock.edit may only
    // touch these running totals.
    function onlyStockTotalsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['quantity', 'costPrice', 'stockState', 'updatedAt']);
    }

    match /users/{businessUid}/products/{productId} {
      allow read: if canReadProducts(businessUid);
      allow create: if hasPermission(businessUid, 'stock', 'create')
        && request.resource.data.businessId == businessUid;
      allow update: if resource.data.businessId == businessUid
        && request.resource.data.businessId == businessUid
        && (
          hasPermission(businessUid, 'stock', 'edit')
          || (
            (
              hasPermission(businessUid, 'stock', 'create')
              || canMoveSaleStock(businessUid)
            )
            && onlyStockTotalsChanged()
          )
        );
      allow delete: if hasPermission(businessUid, 'stock', 'delete');
    }

    match /users/{businessUid}/productCodes/{codeId} {
      allow read: if hasPermission(businessUid, 'stock', 'view')
        || hasPermission(businessUid, 'stock', 'create')
        || hasPermission(businessUid, 'stock', 'edit');
      allow create, update: if hasPermission(businessUid, 'stock', 'create')
        || hasPermission(businessUid, 'stock', 'edit');
      allow delete: if hasPermission(businessUid, 'stock', 'edit')
        || hasPermission(businessUid, 'stock', 'delete');
    }

    match /users/{businessUid}/productBarcodes/{codeId} {
      allow read: if hasPermission(businessUid, 'stock', 'view')
        || hasPermission(businessUid, 'stock', 'create')
        || hasPermission(businessUid, 'stock', 'edit')
        || canMoveSaleStock(businessUid);
      allow create, update: if hasPermission(businessUid, 'stock', 'create')
        || hasPermission(businessUid, 'stock', 'edit');
      allow delete: if hasPermission(businessUid, 'stock', 'edit')
        || hasPermission(businessUid, 'stock', 'delete');
    }

    // Immutable ledger: entries can be created but never edited or deleted.
    match /users/{businessUid}/stockMovements/{movementId} {
      allow get: if hasPermission(businessUid, 'stock', 'view')
        || canMoveSaleStock(businessUid);
      allow list: if hasPermission(businessUid, 'stock', 'view');
      allow create: if request.auth != null
        && request.resource.data.businessId == businessUid
        && request.resource.data.userId == request.auth.uid
        && (
          hasPermission(businessUid, 'stock', 'edit')
          || (
            hasPermission(businessUid, 'stock', 'create')
            && request.resource.data.type in ['purchase', 'opening_stock']
          )
          || (
            canMoveSaleStock(businessUid)
            && request.resource.data.type in ['sale', 'sale_reversal']
          )
        );
      allow update, delete: if false;
    }

    match /users/{businessUid}/purchases/{purchaseId} {
      allow read: if hasPermission(businessUid, 'stock', 'view');
      allow create: if hasPermission(businessUid, 'stock', 'create')
        && request.resource.data.businessId == businessUid;
      allow update, delete: if false;
    }

    match /users/{businessUid}/tasks/{taskId} {
      function isAssignee() {
        return hasActiveMembership(businessUid)
          && resource.data.assigneeUid == request.auth.uid;
      }

      allow read: if hasPermission(businessUid, 'tasks', 'view') || isAssignee();

      // Staff may only progress their own task: tick steps, report collection, submit.
      allow update: if (
        isAssignee()
        && resource.data.status in ['assigned', 'inProgress', 'returned']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progress', 'status', 'startedAt', 'submittedAt', 'collectedAmount',
          'collectedAt', 'paymentMethod', 'collectionNote', 'updatedAt'
        ])
        && request.resource.data.status in ['inProgress', 'submitted']
        && (
          request.resource.data.status != 'submitted'
          || (
            request.resource.data.progress.keys().size() == request.resource.data.steps.size()
            && (
              request.resource.data.type != 'collection'
              || request.resource.data.collectedAmount is number
            )
          )
        )
      ) || (
        hasPermission(businessUid, 'tasks', 'edit')
        && resource.data.assigneeUid != request.auth.uid
        && request.resource.data.assigneeUid == resource.data.assigneeUid
        && request.resource.data.createdBy == resource.data.createdBy
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['transactionId'])
      );

      allow delete: if hasPermission(businessUid, 'tasks', 'delete');

      match /history/{eventId} {
        allow read: if hasPermission(businessUid, 'tasks', 'view')
          || (
            hasActiveMembership(businessUid)
            && get(/databases/$(database)/documents/users/$(businessUid)/tasks/$(taskId))
              .data.assigneeUid == request.auth.uid
          );
        allow create: if (isBusinessOwner(businessUid) || hasActiveMembership(businessUid))
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(
            ['actorUid', 'actorName', 'action', 'note', 'createdAt']
          )
          && request.resource.data.createdAt == request.time;
      }
    }

    match /users/{businessUid}/jobs/{jobId} {
      allow read: if isBusinessOwner(businessUid);
      allow write: if false;
    }

    match /users/{businessUid}/debts/{debtId} {
      allow read: if hasPermission(businessUid, 'jobs', 'view')
        && canAccessDebtShop(businessUid, resource.data);
      allow create: if hasPermission(businessUid, 'jobs', 'create')
        && canAccessDebtShop(businessUid, request.resource.data);
      allow update: if hasPermission(businessUid, 'jobs', 'edit')
        && canAccessDebtShop(businessUid, resource.data)
        && canAccessDebtShop(businessUid, request.resource.data)
        && (
          request.resource.data.get('amountPaid', 0)
            == resource.data.get('amountPaid', 0)
          || (
            request.resource.data.get('amountPaid', 0)
              > resource.data.get('amountPaid', 0)
            && request.resource.data.get('lastPaymentId', '') is string
            && getAfter(/databases/$(database)/documents/users/$(businessUid)/debts/$(debtId)/payments/$(request.resource.data.lastPaymentId)).data.get('amount', 0)
              == request.resource.data.amountPaid
                - resource.data.get('amountPaid', 0)
          )
        );
      allow delete: if hasPermission(businessUid, 'jobs', 'delete')
        && canAccessDebtShop(businessUid, resource.data);

      match /payments/{paymentId} {
        function debtPath() {
          return /databases/$(database)/documents/users/$(businessUid)/debts/$(debtId);
        }

        allow read: if hasPermission(businessUid, 'jobs', 'view')
          && canAccessDebtShop(businessUid, get(debtPath()).data);
        allow create: if hasPermission(businessUid, 'jobs', 'edit')
          && canAccessDebtShop(businessUid, get(debtPath()).data)
          && request.resource.data.get('amount', 0) is number
          && request.resource.data.amount > 0
          && request.resource.data.get('method', '')
            in ['cash', 'mobile_money', 'bank', 'other']
          && request.resource.data.amount
            <= get(debtPath()).data.get('principal', 0)
              - get(debtPath()).data.get('amountPaid', 0)
          && getAfter(debtPath()).data.get('lastPaymentId', '') == paymentId
          && getAfter(debtPath()).data.get('amountPaid', 0)
            == get(debtPath()).data.get('amountPaid', 0)
              + request.resource.data.amount;
        allow update, delete: if false;
      }
    }

    match /receipts/{receiptId} {
      allow get: if resource.data.get('verificationCode', '') == receiptId
        || (
          resource.data.get('businessUid', '') is string
          && hasPermission(resource.data.businessUid, 'receipts', 'view')
        );
      allow list: if resource.data.get('businessUid', '') is string
        && hasPermission(resource.data.businessUid, 'receipts', 'view');
      allow create: if request.resource.data.get('businessUid', '') is string
        && request.resource.data.get('verificationCode', '') == receiptId
        && hasPermission(
          request.resource.data.businessUid,
          'receipts',
          'create'
        );
      allow update: if resource.data.get('businessUid', '') is string
        && request.resource.data.businessUid == resource.data.businessUid
        && hasPermission(resource.data.businessUid, 'receipts', 'edit');
      allow delete: if resource.data.get('businessUid', '') is string
        && hasPermission(resource.data.businessUid, 'receipts', 'delete');
    }

    match /{path=**}/profile/{profileId} {
      // Allow listing/reading profiles only for superadmins, except allow a user
      // to read their own company profile document so the client can determine
      // the user's role without being blocked by the circular check.
      allow get: if isSuperAdmin() || (profileId == 'company' && canReadOwnCompanyProfile(request.auth.uid));
      allow list: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow get: if configId == 'version_policy'
        || configId == 'download_center'
        || configId == 'subscription_plan'
        || configId == 'support_center';
      allow list: if false;
      allow create, update: if isSuperAdmin()
        && configId == 'download_center'
        && validDownloadCenter(request.resource.data);
      allow create: if isSuperAdmin()
        && (
          (configId == 'subscription_plan'
            && validSubscriptionPlan(request.resource.data))
          || (configId == 'version_policy'
            && validAppVersionPolicy(request.resource.data))
          || (configId == 'support_center'
            && validSupportCenter(request.resource.data))
        );
      allow update: if isSuperAdmin()
        && (
          (configId == 'subscription_plan'
            && validSubscriptionPlan(request.resource.data)
            && request.resource.data.version == resource.data.version + 1)
           || (configId == 'subscription_plan'
            && validSubscriptionPlan(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['mobileLogos', 'cardLogos'])
            && request.resource.data.get('mobileLogos', []).size() <= 12
            && request.resource.data.get('cardLogos', []).size() <= 12)
          || (configId == 'version_policy'
            && validAppVersionPolicy(request.resource.data))
          || (configId == 'support_center'
            && validSupportCenter(request.resource.data))
        );
      allow delete: if false;
    }

    function validAnalyticsAdviceCondition(condition) {
      return condition.keys().hasOnly(['metric', 'operator', 'value'])
        && condition.keys().hasAll(['metric', 'operator', 'value'])
        && condition.metric in [
          'income', 'expenses', 'net', 'transactionCount',
          'incomeTransactionCount', 'expenseTransactionCount',
          'averageIncome', 'averageExpense', 'topExpenseSharePercent',
          'incomeChangePercent', 'expenseChangePercent', 'activeTasks',
          'overdueTasks', 'tasksForReview', 'posSalesCount',
          'posSalesTotal', 'staffCount'
        ]
        && condition.operator in ['gt', 'gte', 'lt', 'lte', 'eq']
        && condition.value is number;
    }

    function validAnalyticsAdvice(data, adviceId) {
      return data.keys().hasOnly([
          'id', 'category', 'title', 'description', 'when', 'enabled',
          'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'id', 'category', 'title', 'description', 'when', 'enabled',
          'updatedAt', 'updatedBy'
        ])
        && data.id == adviceId
        && data.category in ['costs', 'growth', 'tasks', 'sales', 'staff', 'records']
        && data.title is map
        && data.title.keys().hasOnly(['en', 'sw'])
        && data.title.keys().hasAll(['en', 'sw'])
        && data.title.en is string
        && data.title.en.size() > 0
        && data.title.en.size() <= 120
        && data.title.sw is string
        && data.title.sw.size() > 0
        && data.title.sw.size() <= 120
        && data.description is map
        && data.description.keys().hasOnly(['en', 'sw'])
        && data.description.keys().hasAll(['en', 'sw'])
        && data.description.en is string
        && data.description.en.size() > 0
        && data.description.en.size() <= 500
        && data.description.sw is string
        && data.description.sw.size() > 0
        && data.description.sw.size() <= 500
        && data.when is list
        && data.when.size() >= 1
        && data.when.size() <= 3
        && validAnalyticsAdviceCondition(data.when[0])
        && (
          data.when.size() < 2
          || validAnalyticsAdviceCondition(data.when[1])
        )
        && (
          data.when.size() < 3
          || validAnalyticsAdviceCondition(data.when[2])
        )
        && data.enabled is bool
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /analyticsAdvice/{adviceId} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin()
        && validAnalyticsAdvice(request.resource.data, adviceId);
      allow delete: if isSuperAdmin();
    }

    match /users/{businessUid}/notifications/{notificationId} {
      allow create: if request.auth != null
        && (isBusinessOwner(businessUid) || hasActiveMembership(businessUid))
        && request.resource.data.keys().hasOnly(
          ['actorUid', 'actorName', 'action', 'summary', 'amount',
           'createdAt', 'read'])
        && request.resource.data.keys().hasAll(
          ['actorUid', 'actorName', 'action', 'summary', 'createdAt', 'read'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 80
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 40
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false;
    }

    match /userNotifications/{uid}/items/{itemId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /deviceTokens/{token} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    match /announcements/{announcementId} {
      allow get, list: if request.auth != null;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(
          ['title', 'body', 'audience', 'createdAt', 'expiresAt', 'createdBy', 'imageUrl'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.audience in ['all', 'subscribers', 'trial', 'expired'];
      allow delete: if isSuperAdmin();

      match /reads/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow get, list: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    match /downloadStats/{metric} {
      allow read: if isSuperAdmin();
      allow create: if metric in ['visits', 'click_playstore', 'click_appstore',
          'click_apk', 'click_windows', 'click_web']
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    match /appActivity/{uid} {
      allow get, list: if isSuperAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['firstSeenAt', 'lastActiveAt', 'platform', 'appVersion', 'opens'])
        && request.resource.data.keys().hasAll(
          ['firstSeenAt', 'lastActiveAt', 'platform', 'appVersion', 'opens'])
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.platform in ['android', 'windows', 'web']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 30
        && request.resource.data.opens == 1;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['firstSeenAt', 'lastActiveAt', 'platform', 'appVersion', 'opens'])
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.platform in ['android', 'windows', 'web']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 30
        && request.resource.data.opens == resource.data.opens + 1;
      allow delete: if false;
    }

    match /subscriptions/{businessUid} {
      allow get: if isBusinessOwner(businessUid)
        || hasActiveMembership(businessUid)
        || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isBusinessOwner(businessUid)
        || isSuperAdmin();
    }

    // MJASI MARKET: public content. Any signed-in account can read it, but
    // only Business owners can publish.
    function validMarketProfile(data) {
      return data.keys().hasOnly([
          'name',
          'nameLower',
          'category',
          'bio',
          'city',
          'photoUrl',
          'whatsapp',
          'followersCount',
          'followingCount',
          'postsCount',
          'createdAt',
          'updatedAt',
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.nameLower is string
        && data.get('category', '') is string
        && data.get('bio', '') is string
        && data.get('bio', '').size() <= 500
        && data.get('city', '').size() <= 80
        && data.get('photoUrl', '').size() <= 2048
        && data.get('whatsapp', '').matches('^$|^[0-9]{8,15}$');
    }

    function validLinkedMarketProduct(data) {
      let productPath = /databases/$(database)/documents/users/$(data.productOwnerUid)/products/$(data.productId);
      return exists(productPath)
        && get(productPath).data.get('active', true) == true
        && data.productName == get(productPath).data.name
        && data.price == get(productPath).data.sellPrice
        && data.inStock == (
          get(productPath).data.get('tracked', true) == false
          || get(productPath).data.get('quantity', 0) > 0
        );
    }

    function validMarketPost(data) {
      return data.keys().hasOnly([
          'authorUid',
          'authorName',
          'authorPhotoUrl',
          'type',
          'caption',
          'category',
          'images',
          'productId',
          'productName',
          'price',
          'productOwnerUid',
          'currency',
          'purchaseMethod',
          'inStock',
          'whatsapp',
          'likesCount',
          'commentsCount',
          'hidden',
          'createdAt',
          'expiresAt',
          'audioUrl',
          'audioTitle',
          'publishAt',
          'publishNotified',
          'videoUrl',
          'textBg',
          'textFont',
        ])
         && data.get('textBg', 0) is int
         && data.get('textBg', 0) >= 0
         && data.get('textBg', 0) < 20
         && data.get('textFont', 0) is int
         && data.get('textFont', 0) >= 0
         && data.get('textFont', 0) < 20
        && data.get('videoUrl', '') is string
        && data.get('videoUrl', '').size() <= 2048
        && (data.get('publishAt', null) == null
          || data.get('publishAt', null) is timestamp)
        && data.get('audioUrl', '') is string
        && data.get('audioUrl', '').size() <= 2048
        && data.get('audioTitle', '') is string
        && data.get('audioTitle', '').size() <= 80
        && data.type in ['post', 'status', 'product']
        && data.get('caption', '') is string
        && data.get('caption', '').size() <= 2000
        && data.images is list
        && (data.images.size() >= 1 || data.get('videoUrl', '').size() > 0
         || (data.type != 'product' && data.get('caption', '').size() > 0))
        && data.images.size() <= 10
        && (data.type != 'status' || data.images.size() <= 1)
        && data.get('purchaseMethod', '') is string
        && (
          data.type != 'product'
          || (
            data.price is number
            && data.price >= 0
            && data.productName is string
            && data.productName.size() > 0
            && data.productName.size() <= 120
            && data.whatsapp is string
            && data.whatsapp.matches('^[0-9]{8,15}$')
            && (
              data.get('productId', '') == ''
              || (
                data.productId is string
                && data.productOwnerUid == data.authorUid
                && validLinkedMarketProduct(data)
              )
            )
          )
        )
        && (
          data.type != 'status'
          || data.get('productId', '') == ''
          || (
            data.productId is string
            && data.productOwnerUid is string
            && data.whatsapp is string
            && data.whatsapp.matches('^[0-9]{8,15}$')
            && (
              isBusinessOwner(data.productOwnerUid)
              || hasPermission(data.productOwnerUid, 'stock', 'view')
            )
            && validLinkedMarketProduct(data)
          )
        );
    }

    match /publicProfiles/{profileUid} {
      allow read: if true;
      allow create: if (
          isBusinessOwner(profileUid)
          || hasPermission(profileUid, 'profile', 'edit')
          || (
            signedIn()
            && request.auth.uid == profileUid
            && isAccountEnabled(request.auth.uid)
          )
        )
        && validMarketProfile(request.resource.data)
        && request.resource.data.get('followersCount', 0) == 0
        && request.resource.data.get('followingCount', 0) == 0
        && request.resource.data.get('postsCount', 0) == 0;
      allow update: if (
          isBusinessOwner(profileUid)
          || hasPermission(profileUid, 'profile', 'edit')
          || (signedIn() && request.auth.uid == profileUid
            && isAccountEnabled(request.auth.uid))
        )
        && validMarketProfile(request.resource.data)
        && request.resource.data.get('followersCount', 0)
          == resource.data.get('followersCount', 0)
        && request.resource.data.get('followingCount', 0)
          == resource.data.get('followingCount', 0)
        && request.resource.data.get('postsCount', 0)
          == resource.data.get('postsCount', 0)
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null);
      allow delete: if isBusinessOwner(profileUid) || isSuperAdmin();

      match /businessDocuments/{documentId} {
        allow get, list: if signedIn() && isAccountEnabled(request.auth.uid);
        allow create, update: if signedIn()
          && isAccountEnabled(request.auth.uid)
          && (
            isBusinessOwner(profileUid)
            || hasPermission(profileUid, 'profile', 'edit')
          )
          && request.resource.data.keys().hasOnly([
            'type', 'fileName', 'url', 'storagePath', 'contentType',
            'uploadedAt', 'uploadedBy'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'fileName', 'url', 'storagePath', 'contentType',
            'uploadedAt', 'uploadedBy'
          ])
          && request.resource.data.type == documentId
          && documentId in ['tin', 'tra', 'brela', 'other']
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() > 0
          && request.resource.data.fileName.size() <= 255
          && request.resource.data.url is string
          && request.resource.data.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.size() <= 500
          && request.resource.data.contentType in [
            'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
          ]
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if signedIn()
          && isAccountEnabled(request.auth.uid)
          && (
            isBusinessOwner(profileUid)
            || hasPermission(profileUid, 'profile', 'edit')
          );
      }
    }

    match /{path=**}/businessDocuments/{documentId} {
      allow get, list: if signedIn() && isAccountEnabled(request.auth.uid);
    }

    match /marketBusinessVerifications/{businessUid} {
      allow get: if signedIn() && isAccountEnabled(request.auth.uid);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'businessUid', 'verified', 'verifiedBy', 'verifiedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'businessUid', 'verified', 'verifiedBy', 'verifiedAt', 'updatedAt'
        ])
        && request.resource.data.businessUid == businessUid
        && request.resource.data.verified is bool
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.verified
          || hasBusinessVerificationDocument(businessUid))
        && (request.resource.data.verified
          ? request.resource.data.verifiedAt == request.time
          : request.resource.data.verifiedAt == null);
      allow delete: if isSuperAdmin();
    }

    match /marketSounds/{soundId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !isSuperAdmin()
        && request.resource.data.keys().hasOnly(['title', 'url', 'createdAt', 'coverUrl', 'durationMs', 'ownerUid', 'source'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.source == 'video'
        && request.resource.data.get('coverUrl', '') is string
        && request.resource.data.get('coverUrl', '').size() <= 2048
        && request.resource.data.get('durationMs', 0) is number
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048;
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['title', 'url', 'createdAt', 'coverUrl', 'durationMs'])
        && request.resource.data.get('coverUrl', '') is string
        && request.resource.data.get('coverUrl', '').size() <= 2048
        && request.resource.data.get('durationMs', 0) is number
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'coverUrl'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.get('coverUrl', '') is string
        && request.resource.data.get('coverUrl', '').size() <= 2048;
      allow delete: if isSuperAdmin()
        || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    match /marketPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && isAccountEnabled(request.auth.uid)
        && validMarketPost(request.resource.data)
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.get('commentsCount', 0) == 0
        && request.resource.data.get('hidden', false) == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('expiresAt', null) == null
        && (
          (
            request.resource.data.type == 'product'
            && (
              isBusinessOwner(request.resource.data.authorUid)
              || hasPermission(
                request.resource.data.authorUid,
                'stock',
                'create'
              )
            )
          )
          || (
            request.resource.data.type in ['post', 'status']
            && request.resource.data.authorUid == request.auth.uid
          )
        );
      allow update: if (
          isBusinessOwner(resource.data.authorUid)
          || (
            resource.data.type in ['post', 'status']
            && resource.data.authorUid == request.auth.uid
          )
          || (
            resource.data.type == 'product'
            && hasPermission(resource.data.authorUid, 'stock', 'edit')
          )
        )
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'caption', 'images', 'category', 'productName', 'price',
          'purchaseMethod', 'whatsapp', 'inStock'
        ])
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.get('likesCount', 0)
          == resource.data.get('likesCount', 0)
        && request.resource.data.get('commentsCount', 0)
          == resource.data.get('commentsCount', 0)
        && validMarketPost(request.resource.data);
      allow delete: if isBusinessOwner(resource.data.authorUid)
        || (resource.data.type in ['post', 'status']
          && resource.data.authorUid == request.auth.uid)
        || (resource.data.type == 'product'
          && hasPermission(resource.data.authorUid, 'stock', 'delete'))
        || isSuperAdmin();

      match /likes/{uid} {
        allow read: if signedIn() && isAccountEnabled(request.auth.uid);
        allow create: if signedIn()
          && isAccountEnabled(request.auth.uid)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (request.auth.uid == uid
            || isBusinessOwner(
              get(/databases/$(database)/documents/marketPosts/$(postId))
                .data.authorUid
            ));
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn() && isAccountEnabled(request.auth.uid);
        allow create: if signedIn()
          && isAccountEnabled(request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'body', 'parentId', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && (request.resource.data.parentId == null
            || (
              request.resource.data.parentId is string
              && exists(/databases/$(database)/documents/marketPosts/$(postId)/comments/$(request.resource.data.parentId))
            ))
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/marketPosts/$(postId))
              .data.authorUid == request.auth.uid
            || isBusinessOwner(
              get(/databases/$(database)/documents/marketPosts/$(postId))
                .data.authorUid
            ));
        allow update: if false;
      }

      match /statusReplies/{replyId} {
        allow create: if signedIn()
          && isAccountEnabled(request.auth.uid)
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('type', '') == 'status'
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('expiresAt', null) > request.time
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'emoji', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() <= 8
          && (request.resource.data.text.size() > 0
            || request.resource.data.emoji.size() > 0)
          && request.resource.data.createdAt == request.time;
        allow get, list: if signedIn()
          && (
            resource.data.senderUid == request.auth.uid
            || get(/databases/$(database)/documents/marketPosts/$(postId))
              .data.authorUid == request.auth.uid
            || isBusinessOwner(
              get(/databases/$(database)/documents/marketPosts/$(postId))
                .data.authorUid
            )
          );
        allow update, delete: if false;
      }

      match /viewers/{uid} {
        allow create: if signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('type', '') == 'status'
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('expiresAt', null) > request.time
          && request.resource.data.keys().hasOnly([
            'viewerName', 'viewerPhotoUrl', 'viewedAt'
          ])
          && request.resource.data.viewerName is string
          && request.resource.data.viewerName.size() <= 80
          && request.resource.data.viewerPhotoUrl is string
          && request.resource.data.viewerPhotoUrl.size() <= 2048
          && request.resource.data.viewedAt == request.time;
        allow get, list: if signedIn()
          && (
            get(/databases/$(database)/documents/marketPosts/$(postId))
              .data.authorUid == request.auth.uid
            || isBusinessOwner(
              get(/databases/$(database)/documents/marketPosts/$(postId))
                .data.authorUid
            )
          );
        allow update: if signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('type', '') == 'status'
          && get(/databases/$(database)/documents/marketPosts/$(postId))
            .data.get('expiresAt', null) > request.time
          && request.resource.data.keys().hasOnly([
            'viewerName', 'viewerPhotoUrl', 'viewedAt'
          ])
          && request.resource.data.viewerName is string
          && request.resource.data.viewerName.size() <= 80
          && request.resource.data.viewerPhotoUrl is string
          && request.resource.data.viewerPhotoUrl.size() <= 2048
          && request.resource.data.viewedAt == request.time;
        allow delete: if false;
      }
    }

    match /marketFollows/{followerUid}/following/{followingUid} {
      allow read: if signedIn() && isAccountEnabled(request.auth.uid);
      allow create: if signedIn()
        && isAccountEnabled(request.auth.uid)
        && request.auth.uid == followerUid
        && request.resource.data.keys().hasOnly([
          'followerUid', 'followingUid', 'createdAt'
        ])
        && request.resource.data.followerUid == followerUid
        && request.resource.data.followingUid == followingUid
        && followingUid != followerUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && request.auth.uid == followerUid;
      allow update: if false;
    }

    match /{path=**}/following/{followingUid} {
      allow read: if signedIn() && isAccountEnabled(request.auth.uid);
    }

    match /marketSavedPosts/{uid}/items/{postId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['postId', 'savedAt'])
        && request.resource.data.postId == postId
        && request.resource.data.savedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /marketContactClicks/{clickId} {
      allow create: if signedIn()
        && isAccountEnabled(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'postId', 'sellerUid', 'buyerUid', 'channel', 'createdAt'
        ])
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.channel == 'whatsapp'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
        && (
          get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
            .data.get('type', '') == 'product'
          || (
            get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
              .data.get('type', '') == 'status'
            && get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
              .data.get('productId', '') is string
            && get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
              .data.get('productId', '').size() > 0
            && validLinkedMarketProduct(
              get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
                .data
            )
          )
        )
        && get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
          .data.get('whatsapp', '').matches('^[0-9]{8,15}$')
        && get(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId))
          .data.authorUid == request.resource.data.sellerUid;
      allow get, list: if signedIn()
        && (resource.data.buyerUid == request.auth.uid
          || isBusinessOwner(resource.data.sellerUid));
      allow update, delete: if false;
    }

    match /marketHiddenPosts/{uid}/items/{postId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['postId', 'hiddenAt'])
        && request.resource.data.postId == postId
        && request.resource.data.hiddenAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /marketReports/{reportId} {
      allow create: if signedIn()
        && isAccountEnabled(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'postId', 'reporterUid', 'reason', 'createdAt', 'status'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam', 'unsafe', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/marketPosts/$(request.resource.data.postId));
      allow get, list, update, delete: if isSuperAdmin();
    }

  }
}
