rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function membershipPath(employeeUid) {
      return /databases/(default)/documents/employeeMemberships/$(employeeUid);
    }

    function isBusinessOwner(businessUid) {
      return request.auth != null
        && request.auth.uid == businessUid
        && !firestore.exists(membershipPath(request.auth.uid));
    }

    function hasActiveMembership(businessUid) {
      return request.auth != null
        && firestore.exists(membershipPath(request.auth.uid))
        && firestore.get(membershipPath(request.auth.uid)).data.businessUid
          == businessUid
        && firestore.get(membershipPath(request.auth.uid)).data.active == true;
    }

    function hasPermission(businessUid, module, action) {
      return isBusinessOwner(businessUid)
        || (
          hasActiveMembership(businessUid)
          && firestore.get(membershipPath(request.auth.uid))
            .data.get('permissions', {})
            .get(module, {})
            .get(action, false) == true
        );
    }

    function canViewProfile(businessUid) {
      return hasPermission(businessUid, 'profile', 'view')
        || hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'quotations', 'create')
        || hasPermission(businessUid, 'receipts', 'create')
        || hasPermission(businessUid, 'jobs', 'create');
    }

    function isSuperAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/profile/company)
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/profile/company)
          .data.get('role', '').lower().replace('_', '').replace('-', '').replace(' ', '')
          == 'superadmin';
    }

    match /downloads/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete' || request.resource.size < 1024 * 1024 * 1024);
    }

    match /announcements/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete'
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /payment_logos/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete'
          || (request.resource.size < 1024 * 1024
            && request.resource.contentType.matches('image/(png|jpeg|webp)')));
    }

    match /users/{businessUid}/products/{fileName} {
      allow read: if hasPermission(businessUid, 'stock', 'view')
        || hasPermission(businessUid, 'invoices', 'create');
      allow write: if (hasPermission(businessUid, 'stock', 'create')
          || hasPermission(businessUid, 'stock', 'edit'))
        && (request.method == 'delete'
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{businessUid}/{filePath=**} {
      allow read: if canViewProfile(businessUid);
      allow write: if hasPermission(businessUid, 'profile', 'edit');
    }
  }
}
