rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function membershipPath(employeeUid) {
      return /databases/(default)/documents/employeeMemberships/$(employeeUid);
    }

    function businessMembershipPath(businessUid, employeeUid) {
      return /databases/(default)/documents/businessMemberships/$(businessUid)/members/$(employeeUid);
    }

    function isBusinessOwner(businessUid) {
      return request.auth != null
        && request.auth.uid == businessUid
        && !firestore.exists(membershipPath(request.auth.uid));
    }

    function isChatBusinessOwner(businessUid) {
      let uid = request.auth == null ? '' : request.auth.uid;
      let legacyPath = membershipPath(uid);
      let modernPath = businessMembershipPath(businessUid, uid);
      return request.auth != null
        && (
          isBusinessOwner(businessUid)
          || (
            firestore.exists(legacyPath)
            && firestore.get(legacyPath).data.businessUid == businessUid
            && firestore.get(legacyPath).data.role == 'owner'
            && firestore.get(legacyPath).data.active == true
          )
          || (
            firestore.exists(modernPath)
            && firestore.get(modernPath).data.businessUid == businessUid
            && firestore.get(modernPath).data.role == 'owner'
            && firestore.get(modernPath).data.active == true
          )
        );
    }

    function hasActiveMembership(businessUid) {
      return request.auth != null
        && (
          (
            firestore.exists(membershipPath(request.auth.uid))
            && firestore.get(membershipPath(request.auth.uid)).data.businessUid
              == businessUid
            && firestore.get(membershipPath(request.auth.uid)).data.active == true
          )
          || (
            firestore.exists(businessMembershipPath(businessUid, request.auth.uid))
            && firestore.get(businessMembershipPath(businessUid, request.auth.uid)).data.businessUid
              == businessUid
            && firestore.get(businessMembershipPath(businessUid, request.auth.uid)).data.active
              == true
          )
        );
    }

    function permissionData(businessUid) {
      return firestore.exists(businessMembershipPath(businessUid, request.auth.uid))
        ? firestore.get(businessMembershipPath(businessUid, request.auth.uid)).data
        : firestore.get(membershipPath(request.auth.uid)).data;
    }

    function hasPermission(businessUid, module, action) {
      return isBusinessOwner(businessUid)
        || (
          hasActiveMembership(businessUid)
          && permissionData(businessUid)
            .get('permissions', {})
            .get(module, {})
            .get(action, false) == true
        );
    }

    function isChatMember(businessUid, conversationId) {
      let conversationPath =
        /databases/(default)/documents/users/$(businessUid)/chats/$(conversationId);
      return request.auth != null
        && firestore.exists(conversationPath)
        && request.auth.uid
          in firestore.get(conversationPath).data.memberUids
        && (
          isChatBusinessOwner(businessUid)
          || hasActiveMembership(businessUid)
        );
    }

    function canReadChat(businessUid, conversationId) {
      return request.auth != null
        && (
          isChatBusinessOwner(businessUid)
          || isChatMember(businessUid, conversationId)
        )
        && firestore.exists(
          /databases/(default)/documents/users/$(businessUid)/chats/$(conversationId)
        );
    }

    function canViewProfile(businessUid) {
      return hasPermission(businessUid, 'profile', 'view')
        || hasPermission(businessUid, 'invoices', 'create')
        || hasPermission(businessUid, 'quotations', 'create')
        || hasPermission(businessUid, 'receipts', 'create')
        || hasPermission(businessUid, 'jobs', 'create');
    }

    function isSuperAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/profile/company)
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/profile/company)
          .data.get('role', '').lower().replace('_', '').replace('-', '').replace(' ', '')
          == 'superadmin';
    }

    match /downloads/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete' || request.resource.size < 1024 * 1024 * 1024);
    }

    match /announcements/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete'
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /payment_logos/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && (request.method == 'delete'
          || (request.resource.size < 1024 * 1024
            && request.resource.contentType.matches('image/(png|jpeg|webp)')));
    }

    match /marketSounds/shared/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && ((request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mpeg|mp4|aac|wav|ogg)'))
          || (request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType.matches('image/(png|jpeg|webp)')));
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || isSuperAdmin());
    }

    match /marketSounds/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin()
        && (request.method == 'delete'
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mpeg|mp4|aac|wav|ogg)'))
          || (request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType.matches('image/(png|jpeg|webp)')));
    }

    match /market/{ownerUid}/audio/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || request.auth.uid == ownerUid
          || hasPermission(ownerUid, 'stock', 'create')
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp4|aac|wav|ogg)');
      allow delete: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || request.auth.uid == ownerUid
          || hasPermission(ownerUid, 'stock', 'delete')
        );
    }

    match /market/{ownerUid}/video/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || hasPermission(ownerUid, 'stock', 'create')
        )
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || hasPermission(ownerUid, 'stock', 'delete')
        );
    }

    match /market/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if (
          request.method == 'delete'
          && (
            isBusinessOwner(ownerUid)
            || request.auth.uid == ownerUid
            || hasPermission(ownerUid, 'stock', 'delete')
          )
        ) || (
          request.method != 'delete'
          && (
            isBusinessOwner(ownerUid)
            || request.auth.uid == ownerUid
            || hasPermission(ownerUid, 'stock', 'create')
          )
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(png|jpeg|webp)')
        );
    }

    match /market/{ownerUid}/profile-images/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || request.auth.uid == ownerUid
          || hasPermission(ownerUid, 'profile', 'edit')
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || request.auth.uid == ownerUid
          || hasPermission(ownerUid, 'profile', 'edit')
        );
    }

    match /market/{ownerUid}/business-documents/{documentType}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || hasPermission(ownerUid, 'profile', 'edit')
        )
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png|webp)'
        );
      allow delete: if request.auth != null
        && (
          isBusinessOwner(ownerUid)
          || hasPermission(ownerUid, 'profile', 'edit')
        );
    }

    function canManageSharedDocument(token) {
      let sharedPath =
        /databases/(default)/documents/sharedDocuments/$(token);
      return request.auth != null
        && firestore.exists(sharedPath)
        && firestore.get(sharedPath).data.get('active', false) == true
        && firestore.get(sharedPath).data.get('businessUid', '') is string
        && firestore.get(sharedPath).data.get('module', '') in [
          'invoices',
          'quotations'
        ]
        && firestore.exists(
          /databases/(default)/documents/users/$(firestore.get(sharedPath).data.businessUid)/invoices/$(firestore.get(sharedPath).data.sourceDocumentId)
        )
        && firestore.get(sharedPath).data.module
          == (
            firestore.get(
              /databases/(default)/documents/users/$(firestore.get(sharedPath).data.businessUid)/invoices/$(firestore.get(sharedPath).data.sourceDocumentId)
            ).data.get('kind', 'invoice') == 'quotation'
              ? 'quotations'
              : 'invoices'
          )
        && (
          hasPermission(
            firestore.get(sharedPath).data.businessUid,
            firestore.get(sharedPath).data.module,
            'create'
          )
          || hasPermission(
            firestore.get(sharedPath).data.businessUid,
            firestore.get(sharedPath).data.module,
            'edit'
          )
        );
    }

    function canRevokeSharedDocument(token) {
      let sharedPath =
        /databases/(default)/documents/sharedDocuments/$(token);
      return request.auth != null
        && firestore.exists(sharedPath)
        && firestore.get(sharedPath).data.get('active', false) == true
        && firestore.get(sharedPath).data.get('businessUid', '') is string
        && firestore.get(sharedPath).data.get('module', '') in [
          'invoices',
          'quotations'
        ]
        && (
          hasPermission(
            firestore.get(sharedPath).data.businessUid,
            firestore.get(sharedPath).data.module,
            'create'
          )
          || hasPermission(
            firestore.get(sharedPath).data.businessUid,
            firestore.get(sharedPath).data.module,
            'edit'
          )
        );
    }

    match /sharedDocuments/{token}/document.pdf {
      allow read: if firestore.exists(
          /databases/(default)/documents/sharedDocuments/$(token)
        )
        && firestore.get(
          /databases/(default)/documents/sharedDocuments/$(token)
        ).data.get('active', false) == true;
      allow create: if canManageSharedDocument(token)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if canRevokeSharedDocument(token);
      allow update: if false;
    }

    match /users/{businessUid}/products/{fileName} {
      allow read: if hasPermission(businessUid, 'stock', 'view')
        || hasPermission(businessUid, 'invoices', 'create');
      allow write: if (hasPermission(businessUid, 'stock', 'create')
          || hasPermission(businessUid, 'stock', 'edit'))
        && (request.method == 'delete'
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /chatAttachments/{businessUid}/{conversationId}/{fileName} {
      allow read: if canReadChat(businessUid, conversationId);
      allow create: if isChatMember(businessUid, conversationId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches(
          '(image/.*|audio/.*|video/.*|application/.*|text/.*)'
        );
      allow update, delete: if false;
    }

    match /userProfiles/{userUid}/profile/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userUid;
      allow create: if request.auth != null
        && request.auth.uid == userUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /users/{businessUid}/{filePath=**} {
      allow read: if canViewProfile(businessUid);
      allow write: if hasPermission(businessUid, 'profile', 'edit');
    }
  }
}
